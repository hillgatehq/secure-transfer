{
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-run --allow-net scripts/build.ts",
    "check": "deno check src/main.tsx src/crypto.ts",
    "test": "deno test --allow-none src/crypto_test.ts",
    "serve": "deno run --allow-read --allow-net jsr:@std/http@1/file-server --port 8099 dist"
  },
  "imports": {
    "preact": "https://esm.sh/preact@10.29.8",
    "preact/hooks": "https://esm.sh/preact@10.29.8/hooks",
    "preact/jsx-runtime": "https://esm.sh/preact@10.29.8/jsx-runtime"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": { "lineWidth": 100, "semiColons": true },
  "lint": { "rules": { "tags": ["recommended"] } }
}
